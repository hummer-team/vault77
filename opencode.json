{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "skill": {
      "*": "allow",
      "pr-review": "allow",
      "internal-log-view": "ask",
      "internal-docs-index": "ask",
      "internal-*": "deny",
      "experimental-*": "ask"
    }
  },
  "agent": {
    "code-review-agent": {
      "mode": "subagent",
      "task_budget": 3
    },
    "develop-agent": {
      "mode": "subagent",
      "task_budget": 3
    }
  }
}